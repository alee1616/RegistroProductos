<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.registroproductos.controller.MenuPrincipalController">
    <children>
        <MenuBar fx:id="mnbMenuPrincipal" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <menus>
                <Menu fx:id="mnuCatalogo" mnemonicParsing="false" text="Catálogo">
                    <items>
                        <MenuItem fx:id="miProductos" mnemonicParsing="false" onAction="#abrirFormProductos" text="Productos" />
                        <MenuItem fx:id="miClientes" mnemonicParsing="false" onAction="#abrirFormClientes" text="Clientes" />
                    </items>
                </Menu>
                <Menu fx:id="mnuReportes" mnemonicParsing="false" text="Reportes">
                    <items>
                        <MenuItem mnemonicParsing="false" text="Reporte1" />
                    </items>
                </Menu>
                <Menu fx:id="nmuSalida" mnemonicParsing="false" text="Salir" />
            </menus>
        </MenuBar>
    </children>
</AnchorPane>